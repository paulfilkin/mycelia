<Window x:Class="Mycelia.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:Mycelia.Ui.Views"
        Title="Mycelia" Width="1440" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource AppBackground}"
        FontFamily="{StaticResource UiFont}" FontSize="13"
        Foreground="{StaticResource Ink}"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">
    <!-- No Icon: the window takes the program's own icon (Resources/Mycelia.ico), whose 16 to 40 px images are the small
         form the artwork asks for, rather than the full icon scaled down. -->
    <Grid x:Name="Root" Background="{StaticResource AppBackground}">
        <Grid.RowDefinitions>
            <RowDefinition Height="56" />
            <RowDefinition Height="*" />
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- Top bar -->
        <Border Grid.Row="0" Background="{StaticResource TopBar}">
            <Grid Margin="16,0,10,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- The wordmark: the mark for dark backgrounds and "mycelia" in lower case, as the artwork sheet sets it. -->
                    <Image Source="{StaticResource MarkImage}" Width="32" Height="32" />
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="mycelia" Foreground="{StaticResource TopBarText}" FontFamily="{StaticResource DisplayFont}" FontSize="19" FontWeight="Bold" Margin="0,-3,0,-2" />
                        <TextBlock x:Name="FileTitle" Text="" Foreground="{StaticResource TopBarMuted}" FontSize="11.5" MaxWidth="220" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </StackPanel>

                <StackPanel x:Name="NavTabs" Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center">
                    <RadioButton x:Name="TabHome" Style="{StaticResource NavTab}" GroupName="ws" Tag="Home" Checked="OnTabChecked">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource I.Home}" Width="16" Height="16" /><TextBlock Text="Home" Margin="7,0,0,0" /></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabPeople" Style="{StaticResource NavTab}" GroupName="ws" Tag="People" Checked="OnTabChecked">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource I.People}" Width="16" Height="16" /><TextBlock Text="People" Margin="7,0,0,0" /></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabPlaces" Style="{StaticResource NavTab}" GroupName="ws" Tag="Places" Checked="OnTabChecked">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource I.Pin}" Width="16" Height="16" /><TextBlock Text="Places" Margin="7,0,0,0" /></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabSources" Style="{StaticResource NavTab}" GroupName="ws" Tag="Sources" Checked="OnTabChecked">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource I.Book}" Width="16" Height="16" /><TextBlock Text="Sources" Margin="7,0,0,0" /></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabMedia" Style="{StaticResource NavTab}" GroupName="ws" Tag="Media" Checked="OnTabChecked">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource I.Image}" Width="16" Height="16" /><TextBlock Text="Media" Margin="7,0,0,0" /></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabCharts" Style="{StaticResource NavTab}" GroupName="ws" Tag="Charts" Checked="OnTabChecked">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource I.Chart}" Width="16" Height="16" /><TextBlock Text="Charts" Margin="7,0,0,0" /></StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="TabTools" Style="{StaticResource NavTab}" GroupName="ws" Tag="Tools" Checked="OnTabChecked">
                        <StackPanel Orientation="Horizontal"><Path Style="{StaticResource Icon}" Data="{StaticResource I.Tools}" Width="16" Height="16" /><TextBlock Text="Tools" Margin="7,0,0,0" /></StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Shown when a newer version is found (TDD 23); a click checks again and offers it. -->
                    <Button x:Name="UpdateButton" Style="{StaticResource ButtonBase}" Visibility="Collapsed" Click="OnUpdateNotice"
                            Background="{StaticResource BrandAccent}" Foreground="{StaticResource Ink}" BorderThickness="0" Padding="10,5" Margin="0,0,8,0" FontWeight="SemiBold">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Import}" Width="15" Height="15" />
                            <TextBlock x:Name="UpdateLabel" Text="Update available" Margin="6,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="AssistantButton" Style="{StaticResource TopBarButton}" ToolTip="Show or hide the Assistant" Click="OnAssistant">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Assistant}" />
                            <TextBlock x:Name="AssistantLabel" Text="Assistant" Margin="6,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Border Width="1" Height="22" Background="#33FFFFFF" Margin="6,0" />
                    <Button x:Name="BackButton" Style="{StaticResource TopBarButton}" ToolTip="Back (Alt+Left)" Click="OnBack">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.ArrowLeft}" />
                    </Button>
                    <Button x:Name="ForwardButton" Style="{StaticResource TopBarButton}" ToolTip="Forward (Alt+Right)" Click="OnForward">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.ArrowRight}" />
                    </Button>
                    <Border Width="1" Height="22" Background="#33FFFFFF" Margin="6,0" />
                    <Button x:Name="UndoButton" Style="{StaticResource TopBarButton}" ToolTip="Undo (Ctrl+Z)" Click="OnUndo">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Undo}" />
                    </Button>
                    <Button x:Name="RedoButton" Style="{StaticResource TopBarButton}" ToolTip="Redo (Ctrl+Y)" Click="OnRedo">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Redo}" />
                    </Button>
                    <Border Width="1" Height="22" Background="#33FFFFFF" Margin="6,0" />
                    <Button Style="{StaticResource TopBarButton}" ToolTip="Save (Ctrl+S)" Click="OnSave">
                        <StackPanel Orientation="Horizontal">
                            <Path Style="{StaticResource Icon}" Data="{StaticResource I.Save}" />
                            <TextBlock x:Name="SaveLabel" Text="Save" Margin="6,0,2,0" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="MenuButton" Style="{StaticResource TopBarButton}" ToolTip="File" Click="OnMenu">
                        <Path Style="{StaticResource Icon}" Data="{StaticResource I.Menu}" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Workspaces, and the Assistant pane on the right (hidden until opened) -->
        <Grid x:Name="Body" Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition x:Name="AssistantColumn" Width="0" />
            </Grid.ColumnDefinitions>
            <Grid x:Name="WorkspaceHost" Grid.Column="0">
                <views:HomeView x:Name="HomeView" Visibility="Collapsed" />
                <views:PeopleView x:Name="PeopleView" Visibility="Collapsed" />
                <views:PlacesView x:Name="PlacesView" Visibility="Collapsed" />
                <views:SourcesView x:Name="SourcesView" Visibility="Collapsed" />
                <views:MediaView x:Name="MediaView" Visibility="Collapsed" />
                <views:ChartsView x:Name="ChartsView" Visibility="Collapsed" />
                <views:ToolsView x:Name="ToolsView" Visibility="Collapsed" />
            </Grid>
            <!-- The drag handle lies over the workspace's own 12 px margin, so the gap matches the gaps between panels. -->
            <Thumb x:Name="AssistantSplitter" Grid.Column="1" Width="12" Margin="-12,12,0,12" Cursor="SizeWE" Visibility="Collapsed"
                   Panel.ZIndex="1" DragDelta="OnAssistantDrag" DragCompleted="OnAssistantDragDone">
                <Thumb.Template>
                    <ControlTemplate TargetType="Thumb">
                        <Border Background="Transparent" />
                    </ControlTemplate>
                </Thumb.Template>
            </Thumb>
            <ContentControl x:Name="AssistantHost" Grid.Column="2" Margin="0,12,12,12" Focusable="False" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="2" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0">
            <DockPanel Margin="16,0" VerticalAlignment="Center">
                <TextBlock x:Name="StatusRight" DockPanel.Dock="Right" Style="{StaticResource Caption}" />
                <!-- Other programs using the tools (TDD 24); empty while they are switched off. -->
                <TextBlock x:Name="ServingStatus" DockPanel.Dock="Right" Style="{StaticResource Caption}" Margin="0,0,28,0" Foreground="{StaticResource Brand}" />
                <TextBlock x:Name="StatusLeft" Style="{StaticResource Caption}" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
