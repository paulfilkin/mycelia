    <SolidColorBrush x:Key="Surface" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceAlt" Color="#F8FAF6" />
    <SolidColorBrush x:Key="Hover" Color="#EEF2EA" />
    <SolidColorBrush x:Key="Border" Color="#E0E5DC" />
    <SolidColorBrush x:Key="BorderStrong" Color="#C6CFC1" />

    <SolidColorBrush x:Key="Male" Color="#3D72AE" />
