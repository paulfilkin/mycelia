<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Palette, from the Mycelia artwork sheet (Docs/Design/Artwork): Forest floor, Subsoil, Thread, Spore amber,
         Foxfire and Ink.  The brand colour on light surfaces is Foxfire on light; the top bar is Forest floor. -->
    <SolidColorBrush x:Key="ForestFloor" Color="#0F1F1A" />
    <SolidColorBrush x:Key="Subsoil" Color="#0A1612" />
    <SolidColorBrush x:Key="Thread" Color="#E8EDE4" />
    <SolidColorBrush x:Key="SporeAmber" Color="#F4B740" />
    <SolidColorBrush x:Key="Foxfire" Color="#9BE564" />

    <Color x:Key="BrandColor">#2F7D32</Color>
    <Color x:Key="BrandDarkColor">#0F1F1A</Color>
    <SolidColorBrush x:Key="Brand" Color="#2F7D32" />
    <SolidColorBrush x:Key="BrandHover" Color="#378E3B" />
    <SolidColorBrush x:Key="BrandPressed" Color="#276A2A" />
    <SolidColorBrush x:Key="BrandSoft" Color="#E7F1E3" />
    <SolidColorBrush x:Key="BrandSofter" Color="#F3F8F0" />
    <SolidColorBrush x:Key="BrandAccent" Color="#9BE564" />
    <!-- Between Foxfire on light and Foxfire, for marks on white where the brand green is already in use (bars, dots). -->
    <SolidColorBrush x:Key="BrandMid" Color="#5DAA5F" />
    <SolidColorBrush x:Key="TopBar" Color="#0F1F1A" />
    <SolidColorBrush x:Key="TopBarText" Color="#E8EDE4" />
    <SolidColorBrush x:Key="TopBarMuted" Color="#A3B0A7" />

    <SolidColorBrush x:Key="Ink" Color="#12241E" />
