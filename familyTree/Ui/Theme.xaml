    <!-- Inter for the interface and Space Grotesk for the wordmark and headings, built in from Resources/Fonts (SIL Open
         Font License 1.1, the licences beside them).  Both are variable fonts; WPF renders their named weights, and Space
         Grotesk has no 600, so headings and the wordmark use its Bold. -->
    <FontFamily x:Key="UiFont">pack://application:,,,/Resources/Fonts/#Inter</FontFamily>
    <FontFamily x:Key="DisplayFont">pack://application:,,,/Resources/Fonts/#Space Grotesk</FontFamily>

