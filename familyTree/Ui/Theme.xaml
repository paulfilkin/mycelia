    <SolidColorBrush x:Key="AccentTextFillColorSecondaryBrush" Color="#276A2A" />
    <SolidColorBrush x:Key="AccentTextFillColorTertiaryBrush" Color="#3E9442" />
    <!-- A focused text field's underline: the Fluent theme's own brush, with the brand green for the accent. -->
    <LinearGradientBrush x:Key="TextControlBorderBrushFocused" StartPoint="0,0" EndPoint="0,2" MappingMode="Absolute">
        <GradientStop Color="#2F7D32" Offset="1" />
        <GradientStop Color="#0F000000" Offset="1" />
        <LinearGradientBrush.RelativeTransform><ScaleTransform ScaleY="-1" CenterY="0.5" /></LinearGradientBrush.RelativeTransform>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="TextControlElevationBorderFocusedBrush" StartPoint="0,0" EndPoint="0,2" MappingMode="Absolute">
        <GradientStop Color="#2F7D32" Offset="1" />
        <GradientStop Color="#0F000000" Offset="1" />
        <LinearGradientBrush.RelativeTransform><ScaleTransform ScaleY="-1" CenterY="0.5" /></LinearGradientBrush.RelativeTransform>
    </LinearGradientBrush>
