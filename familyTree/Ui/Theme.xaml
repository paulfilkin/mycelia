    <!-- The Mycelia mark and icon, drawn from the SVGs in Docs/Design/Artwork (96 x 96): three people (amber) above the
         line, joined at the core to five sources (green) below it by the mycelium.  tools/make-icon.ps1 makes the icon
         file from IconImage (48 px and up) and IconSmallImage (40 px and down), as the artwork sheet says. -->
    <Geometry x:Key="Mark.Web">M14 70Q22 78 31 80Q40 85 48 84Q56 85 65 80Q74 78 82 70</Geometry>
    <Geometry x:Key="Mark.Roots">M48 48C48 60 14 58 14 70M48 48C48 62 31 66 31 80M48 48V84M48 48C48 62 65 66 65 80M48 48C48 60 82 58 82 70</Geometry>
    <Geometry x:Key="Mark.Stems">M48 48C48 36 24 36 24 22M48 48V16M48 48C48 36 72 36 72 22</Geometry>
    <GeometryGroup x:Key="Mark.Sources">
        <EllipseGeometry Center="14,70" RadiusX="3.5" RadiusY="3.5" />
        <EllipseGeometry Center="31,80" RadiusX="3.5" RadiusY="3.5" />
        <EllipseGeometry Center="48,84" RadiusX="3.5" RadiusY="3.5" />
        <EllipseGeometry Center="65,80" RadiusX="3.5" RadiusY="3.5" />
        <EllipseGeometry Center="82,70" RadiusX="3.5" RadiusY="3.5" />
    </GeometryGroup>
    <GeometryGroup x:Key="Mark.People">
        <EllipseGeometry Center="24,22" RadiusX="5.5" RadiusY="5.5" />
        <EllipseGeometry Center="48,16" RadiusX="5.5" RadiusY="5.5" />
        <EllipseGeometry Center="72,22" RadiusX="5.5" RadiusY="5.5" />
    </GeometryGroup>
    <EllipseGeometry x:Key="Mark.Core" Center="48,48" RadiusX="6.5" RadiusY="6.5" />

    <!-- The mark for dark backgrounds (mycelia-mark.svg): the top bar, and inside the app icon. -->
    <DrawingCollection x:Key="MarkDrawings">
        <GeometryDrawing Geometry="{StaticResource Mark.Web}">
            <GeometryDrawing.Pen><Pen Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"><Pen.Brush><SolidColorBrush Color="#E8EDE4" Opacity="0.45" /></Pen.Brush></Pen></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="{StaticResource Mark.Roots}">
            <GeometryDrawing.Pen><Pen Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"><Pen.Brush><SolidColorBrush Color="#E8EDE4" Opacity="0.7" /></Pen.Brush></Pen></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Geometry="{StaticResource Mark.Stems}">
            <GeometryDrawing.Pen><Pen Brush="#E8EDE4" Thickness="3" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
        </GeometryDrawing>
        <GeometryDrawing Brush="#9BE564" Geometry="{StaticResource Mark.Sources}" />
        <GeometryDrawing Brush="#F4B740" Geometry="{StaticResource Mark.People}" />
        <GeometryDrawing Brush="#E8EDE4" Geometry="{StaticResource Mark.Core}" />
    </DrawingCollection>
    <DrawingImage x:Key="MarkImage">
        <DrawingImage.Drawing><DrawingGroup Children="{StaticResource MarkDrawings}" /></DrawingImage.Drawing>
    </DrawingImage>

    <!-- The mark for light backgrounds (mycelia-mark-ink.svg): Home and the update offer. -->
    <DrawingImage x:Key="MarkInkImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Geometry="{StaticResource Mark.Web}">
                    <GeometryDrawing.Pen><Pen Thickness="1.5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"><Pen.Brush><SolidColorBrush Color="#12241E" Opacity="0.4" /></Pen.Brush></Pen></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="{StaticResource Mark.Roots}">
                    <GeometryDrawing.Pen><Pen Thickness="2" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"><Pen.Brush><SolidColorBrush Color="#12241E" Opacity="0.65" /></Pen.Brush></Pen></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="{StaticResource Mark.Stems}">
                    <GeometryDrawing.Pen><Pen Brush="#12241E" Thickness="3" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#2F7D32" Geometry="{StaticResource Mark.Sources}" />
                <GeometryDrawing Brush="#B86E00" Geometry="{StaticResource Mark.People}" />
                <GeometryDrawing Brush="#12241E" Geometry="{StaticResource Mark.Core}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- The app icon (mycelia-icon.svg): the mark on a Forest floor tile with Subsoil below the line. -->
    <DrawingImage x:Key="IconImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#0F1F1A">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,96,96" RadiusX="22" RadiusY="22" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#0A1612" Geometry="M0 48H96V74A22 22 0 0 1 74 96H22A22 22 0 0 1 0 74Z" />
                <GeometryDrawing Geometry="M0 48H96">
                    <GeometryDrawing.Pen><Pen Thickness="1"><Pen.Brush><SolidColorBrush Color="#E8EDE4" Opacity="0.22" /></Pen.Brush></Pen></GeometryDrawing.Pen>
                </GeometryDrawing>
                <DrawingGroup Transform="0.9,0,0,0.9,4.8,4.8" Children="{StaticResource MarkDrawings}" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- The icon at 40 px and below (mycelia-icon-small.svg): three sources and heavier strokes. -->
    <DrawingImage x:Key="IconSmallImage">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#0F1F1A">
                    <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,96,96" RadiusX="22" RadiusY="22" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M48 48C48 62 22 60 22 76M48 48V82M48 48C48 62 74 60 74 76">
                    <GeometryDrawing.Pen><Pen Thickness="4" StartLineCap="Round" EndLineCap="Round" LineJoin="Round"><Pen.Brush><SolidColorBrush Color="#E8EDE4" Opacity="0.8" /></Pen.Brush></Pen></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="{StaticResource Mark.Stems}">
                    <GeometryDrawing.Pen><Pen Brush="#E8EDE4" Thickness="5" StartLineCap="Round" EndLineCap="Round" LineJoin="Round" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#9BE564">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="22,76" RadiusX="6.5" RadiusY="6.5" />
                            <EllipseGeometry Center="48,82" RadiusX="6.5" RadiusY="6.5" />
                            <EllipseGeometry Center="74,76" RadiusX="6.5" RadiusY="6.5" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#F4B740">
                    <GeometryDrawing.Geometry>
                        <GeometryGroup>
                            <EllipseGeometry Center="24,22" RadiusX="8" RadiusY="8" />
                            <EllipseGeometry Center="48,16" RadiusX="8" RadiusY="8" />
                            <EllipseGeometry Center="72,22" RadiusX="8" RadiusY="8" />
                        </GeometryGroup>
                    </GeometryDrawing.Geometry>
                </GeometryDrawing>
                <GeometryDrawing Brush="#E8EDE4">
                    <GeometryDrawing.Geometry><EllipseGeometry Center="48,48" RadiusX="9" RadiusY="9" /></GeometryDrawing.Geometry>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <!-- Text -->
    <Style x:Key="H1" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="26" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="H2" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource DisplayFont}" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="H3" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
    </Style>
    <Style x:Key="Caption" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="SectionLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{StaticResource Subtle}" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!-- Icon drawn with the surrounding text colour. -->
    <Style x:Key="Icon" TargetType="Path">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="StrokeThickness" Value="1.7" />
        <Setter Property="StrokeLineJoin" Value="Round" />
        <Setter Property="StrokeStartLineCap" Value="Round" />
        <Setter Property="StrokeEndLineCap" Value="Round" />
        <Setter Property="SnapsToDevicePixels" Value="False" />
        <Setter Property="Stroke" Value="{Binding (TextElement.Foreground), RelativeSource={RelativeSource Self}}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- Surfaces -->
    <Style x:Key="Card" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="16" />
    </Style>
    <Style x:Key="Panel" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource Border}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
    </Style>

    <!-- Buttons -->
    <Style x:Key="ButtonBase" TargetType="Button">
        <Setter Property="FontFamily" Value="{StaticResource UiFont}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource BrandAccent}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Brand}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderBrush" Value="{StaticResource Brand}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrandHover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BrandPressed}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="SecondaryButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="{StaticResource Surface}" />
        <Setter Property="Foreground" Value="{StaticResource Ink}" />
        <Setter Property="BorderBrush" Value="{StaticResource BorderStrong}" />
        <Setter Property="BorderThickness" Value="1" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Hover}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{StaticResource BrandSoft}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="GhostButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Brand}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8,5" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource BrandSoft}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="IconButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{StaticResource Hover}" />
                <Setter Property="Foreground" Value="{StaticResource Ink}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style x:Key="TopBarButton" TargetType="Button" BasedOn="{StaticResource ButtonBase}">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{StaticResource TopBarText}" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="8" />
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="36" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="#1FFFFFFF" />
                <Setter Property="Foreground" Value="White" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Workspace tabs in the top bar -->
    <Style x:Key="NavTab" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource TopBarMuted}" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Margin" Value="2,0" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Grid Background="Transparent">
                        <Border x:Name="Pill" CornerRadius="8" Margin="0,10" Padding="12,0" Background="Transparent">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <Border x:Name="Bar" Height="3" CornerRadius="1.5" VerticalAlignment="Bottom" Margin="12,0" Background="{StaticResource BrandAccent}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Pill" Property="Background" Value="#18FFFFFF" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="White" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Segmented toggles (view switches) -->
    <Style x:Key="Segment" TargetType="RadioButton">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border x:Name="Bd" CornerRadius="6" Padding="10,5" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                        </Trigger>
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Surface}" />
                            <Setter Property="Foreground" Value="{StaticResource Brand}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Tabs inside panels -->
    <Style x:Key="PanelTab" TargetType="TabItem">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid Margin="0,0,18,0" Background="Transparent">
                        <ContentPresenter ContentSource="Header" Margin="0,8,0,10" />
                        <Border x:Name="Bar" Height="2.5" VerticalAlignment="Bottom" CornerRadius="1" Background="{StaticResource Brand}" Visibility="Hidden" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter Property="Foreground" Value="{StaticResource Ink}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PanelTabs" TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource PanelTab}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <DockPanel>
                        <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="16,0">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                        <!-- The name lets UI Automation (screen readers) reach the selected tab's contents. -->
                        <ContentPresenter x:Name="PART_SelectedContentHost" ContentSource="SelectedContent" />
                    </DockPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Plain list rows -->
    <Style x:Key="ListRow" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border x:Name="Bd" CornerRadius="7" Background="Transparent" Padding="8,6">
                        <ContentPresenter />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource Hover}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource BrandSoft}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PlainList" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ItemContainerStyle" Value="{StaticResource ListRow}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="VirtualizingPanel.IsVirtualizing" Value="True" />
        <Setter Property="VirtualizingPanel.ScrollUnit" Value="Pixel" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <ScrollViewer Focusable="False" Padding="{TemplateBinding Padding}">
                        <ItemsPresenter />
                    </ScrollViewer>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Border}" />
        <Setter Property="Margin" Value="0,12" />
    </Style>

    <Style x:Key="Badge" TargetType="Border">
        <Setter Property="Background" Value="{StaticResource BrandSoft}" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>

</ResourceDictionary>
